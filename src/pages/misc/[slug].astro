---
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../components/Layout.astro';
import ThumbnailGrid from '../../components/ThumbnailGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { buildEntryPageData } from '../../lib/entry-page';
import { withBase } from '../../lib/paths';
import { getTaskTitle } from '../../lib/tasks';

export async function getStaticPaths() {
  const entries = await getCollection('misc');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const taskMetaEntries = await getCollection('taskMeta');
const relatedTaskLabel = entry.data.relatedTask
  ? `Task ${entry.data.relatedTask}: ${getTaskTitle(taskMetaEntries, entry.data.relatedTask)}`
  : null;

const globMap = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/misc/**/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const { captureImages, mentorImages, blocks, description, hasResponse } = buildEntryPageData(
  globMap,
  `/src/content/misc/${entry.id}`,
  entry,
);

const cover = captureImages[0]?.src;
const ogImageResult = cover ? await getImage({ src: cover, width: 1200 }) : null;
const ogImage = ogImageResult ? new URL(ogImageResult.src, Astro.site).toString() : undefined;
---
<Layout title={entry.data.title} description={description} ogImage={ogImage}>
  <Breadcrumb
    items={[
      { label: 'Misc', href: withBase('/misc/', import.meta.env.BASE_URL) },
      { label: entry.data.title },
    ]}
  />
  <article class="subtask">
    <header class="misc-header">
      <h1>{entry.data.title}</h1>
      <span class="misc-badge mono">MISC</span>
    </header>
    {relatedTaskLabel && (
      <p class="related-task-tag">
        <a href={withBase(`/tasks/${entry.data.relatedTask}/assignment/`, import.meta.env.BASE_URL)}>
          &rarr; {relatedTaskLabel}
        </a>
      </p>
    )}

    <section class="assignment">
      <h2>Context</h2>
      {entry.data.mentorPrompt ? <p>{entry.data.mentorPrompt}</p> : <p class="empty-state">Pending.</p>}
      {mentorImages.length > 0 && (
        <div class="mentor-images">
          {mentorImages.map((img) => (
            <Image src={img.src} width={480} alt={img.parsed.label} />
          ))}
        </div>
      )}
    </section>

    <section class="captures">
      <h2>Images</h2>
      {blocks.length > 0 ? <ThumbnailGrid blocks={blocks} /> : <p class="empty-state">No images yet.</p>}
    </section>

    <section class="response">
      {hasResponse ? <Content /> : <p class="empty-state">Pending.</p>}
    </section>
  </article>

  <Lightbox />
</Layout>
