---
import { getCollection } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import TaskCard from '../../../components/TaskCard.astro';
import { withBase } from '../../../lib/paths';
import { tasksForWeek, weekNumbers } from '../../../lib/weeks';

const weekMetaEntries = await getCollection('weekMeta');
const weekTaskEntries = await getCollection('weekTasks');
const weeks = weekNumbers(weekMetaEntries);
---
<Layout title="Weekly Programme" description="Mr Casino's weekly programme of formal assignments, one topic per Week.">
  <Breadcrumb
    items={[
      { label: 'Tasks', href: withBase('/', import.meta.env.BASE_URL) },
      { label: 'Weekly Programme' },
    ]}
  />
  <h1>Weekly Programme</h1>
  <p class="page-intro">
    Mr Casino's weekly programme: one topic per Week, each with its own formal Tasks. Each Week's page pairs every
    Task's assignment with my own work. Week tasks are numbered within their Week and are separate from the
    earlier <a href={withBase('/', import.meta.env.BASE_URL)}>standalone Tasks 1-3</a>.
  </p>
  {weeks.length === 0 && <p class="empty-state">No weeks yet.</p>}
  <div class="card-grid">
    {weeks.map((week) => {
      const meta = weekMetaEntries.find((entry) => entry.id === week)!;
      return (
        <TaskCard
          href={withBase(`/tasks/weeks/${week}/`, import.meta.env.BASE_URL)}
          badge={`WEEK ${week}`}
          title={meta.data.title}
          cover={null}
          subtaskCount={tasksForWeek(weekTaskEntries, week).length}
        />
      );
    })}
  </div>
</Layout>
