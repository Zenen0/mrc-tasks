---
// One My Work entry for a Week Task (src/content/weeks/<N>/task-<M>/mine/<entry>/index.md).
// Mirrors the standalone subtask page (src/pages/tasks/[task]/[subtask].astro).
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../../../../components/Layout.astro';
import ThumbnailGrid from '../../../../../../components/ThumbnailGrid.astro';
import Lightbox from '../../../../../../components/Lightbox.astro';
import Breadcrumb from '../../../../../../components/Breadcrumb.astro';
import { buildEntryPageData } from '../../../../../../lib/entry-page';
import { withBase } from '../../../../../../lib/paths';
import { siblingSubtasks } from '../../../../../../lib/tasks';
import { weekTaskNumber, workForWeekTask } from '../../../../../../lib/weeks';

export async function getStaticPaths() {
  const work = await getCollection('weekWork');
  return work.map((entry) => {
    const [week, wtask, , id] = entry.id.split('/');
    return { params: { week, wtask, entry: id }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { week, wtask, entry: entryId } = Astro.params as { week: string; wtask: string; entry: string };
const number = weekTaskNumber(wtask);
const { Content } = await render(entry);

const globMap = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/weeks/**/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const { mentorImages, blocks, description, hasResponse } = buildEntryPageData(
  globMap,
  `/src/content/weeks/${entry.id}`,
  entry,
);

const weekMeta = (await getCollection('weekMeta')).find((meta) => meta.id === week);
const weekTitle = `Week ${week}: ${weekMeta?.data.title ?? ''}`;
const siblings = workForWeekTask(await getCollection('weekWork'), week, wtask);
const { prev, next } = siblingSubtasks(siblings, entry.id);
const base = import.meta.env.BASE_URL;
const mineHref = `/tasks/weeks/${week}/${wtask}/mine/`;
---
<Layout title={`Week ${week} · Task ${number} · ${entryId.toUpperCase()}: ${entry.data.title}`} description={description}>
  <Breadcrumb
    items={[
      { label: 'Tasks', href: withBase('/', base) },
      { label: 'Weekly Programme', href: withBase('/tasks/weeks/', base) },
      { label: weekTitle, href: withBase(`/tasks/weeks/${week}/`, base) },
      { label: `Task ${number}`, href: withBase(`/tasks/weeks/${week}/#${wtask}`, base) },
      { label: 'My Work', href: withBase(mineHref, base) },
      { label: entryId.toUpperCase() },
    ]}
  />
  {(prev || next) && (
    <nav class="subtask-pager" aria-label="Entry navigation">
      {prev && (
        <a class="pager-prev" href={withBase(`${mineHref}${prev.id.split('/').pop()}/`, base)}>
          &lsaquo; {prev.id.split('/').pop()!.toUpperCase()}: {prev.data.title}
        </a>
      )}
      {next && (
        <a class="pager-next" href={withBase(`${mineHref}${next.id.split('/').pop()}/`, base)}>
          {next.id.split('/').pop()!.toUpperCase()}: {next.data.title} &rsaquo;
        </a>
      )}
    </nav>
  )}
  <article class="subtask">
    <header class="subtask-header week-header">
      <span class="subtask-badge mono">W{week} · T{number} · {entryId.toUpperCase()}</span>
      <h1>{entry.data.title}</h1>
    </header>

    {(entry.data.mentorPrompt || mentorImages.length > 0) && (
      <section class="assignment">
        <h2>Assignment</h2>
        {entry.data.mentorPrompt && <p>{entry.data.mentorPrompt}</p>}
        {mentorImages.length > 0 && (
          <div class="mentor-images">
            {mentorImages.map((img) => (
              <Image src={img.src} width={480} alt={img.parsed.label} />
            ))}
          </div>
        )}
      </section>
    )}

    <section class="captures">
      <h2>Captures</h2>
      {blocks.length > 0 ? <ThumbnailGrid blocks={blocks} /> : <p class="empty-state">No captures yet.</p>}
    </section>

    <section class="response">
      <h2>My read</h2>
      {hasResponse ? <Content /> : <p class="empty-state">Pending.</p>}
    </section>
  </article>

  <Lightbox />
</Layout>
