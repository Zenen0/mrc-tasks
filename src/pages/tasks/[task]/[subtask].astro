---
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../../components/Layout.astro';
import ThumbnailGrid from '../../../components/ThumbnailGrid.astro';
import Lightbox from '../../../components/Lightbox.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { buildEntryPageData } from '../../../lib/entry-page';
import { withBase } from '../../../lib/paths';
import { getTaskTitle, siblingSubtasks, subtasksForTask } from '../../../lib/tasks';

export async function getStaticPaths() {
  const entries = await getCollection('tasks');
  return entries.map((entry) => {
    const [task, subtask] = entry.id.split('/');
    return { params: { task, subtask }, props: { entry } };
  });
}

const { entry } = Astro.props;
const [task, subtask] = entry.id.split('/');
const { Content } = await render(entry);

const globMap = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/tasks/**/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const { captureImages, mentorImages, blocks, description, hasResponse } = buildEntryPageData(
  globMap,
  `/src/content/tasks/${entry.id}`,
  entry,
);

const cover = captureImages[0]?.src;
const ogImageResult = cover ? await getImage({ src: cover, width: 1200 }) : null;
const ogImage = ogImageResult ? new URL(ogImageResult.src, Astro.site).toString() : undefined;

const allEntries = await getCollection('tasks');
const taskMetaEntries = await getCollection('taskMeta');
const taskTitle = getTaskTitle(taskMetaEntries, task);
const siblings = subtasksForTask(allEntries, task);
const { prev, next } = siblingSubtasks(siblings, entry.id);
---
<Layout title={`${task}${subtask.toUpperCase()}: ${entry.data.title}`} description={description} ogImage={ogImage}>
  <Breadcrumb
    items={[
      { label: 'Tasks', href: withBase('/', import.meta.env.BASE_URL) },
      { label: taskTitle, href: withBase(`/tasks/${task}/`, import.meta.env.BASE_URL) },
      { label: `${task}${subtask.toUpperCase()}` },
    ]}
  />
  {(prev || next) && (
    <nav class="subtask-pager" aria-label="Subtask navigation">
      {prev && (
        <a class="pager-prev" href={withBase(`/tasks/${prev.id}/`, import.meta.env.BASE_URL)}>
          &lsaquo; {prev.id.split('/')[1].toUpperCase()}: {prev.data.title}
        </a>
      )}
      {next && (
        <a class="pager-next" href={withBase(`/tasks/${next.id}/`, import.meta.env.BASE_URL)}>
          {next.id.split('/')[1].toUpperCase()}: {next.data.title} &rsaquo;
        </a>
      )}
    </nav>
  )}
  <article class="subtask">
    <header class="subtask-header">
      <span class="subtask-badge mono">{task}{subtask.toUpperCase()}</span>
      <h1>{entry.data.title}</h1>
    </header>

    <section class="assignment">
      <h2>Assignment</h2>
      {entry.data.mentorPrompt ? <p>{entry.data.mentorPrompt}</p> : <p class="empty-state">Pending.</p>}
      {mentorImages.length > 0 && (
        <div class="mentor-images">
          {mentorImages.map((img) => (
            <Image src={img.src} width={480} alt={img.parsed.label} />
          ))}
        </div>
      )}
    </section>

    <section class="captures">
      <h2>Captures</h2>
      {blocks.length > 0 ? <ThumbnailGrid blocks={blocks} /> : <p class="empty-state">No captures yet.</p>}
    </section>

    <section class="response">
      <h2>My read</h2>
      {hasResponse ? <Content /> : <p class="empty-state">Pending.</p>}
    </section>
  </article>

  <Lightbox />
</Layout>
