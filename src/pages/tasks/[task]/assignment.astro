---
import { getCollection, render } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { withBase } from '../../../lib/paths';
import { truncateExcerpt } from '../../../lib/og';
import { getTaskTitle } from '../../../lib/tasks';

export async function getStaticPaths() {
  const taskMetaEntries = await getCollection('taskMeta');
  return taskMetaEntries.map((entry) => ({ params: { task: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { task } = Astro.params as { task: string };
const { Content } = await render(entry);

const taskMetaEntries = await getCollection('taskMeta');
const taskTitle = getTaskTitle(taskMetaEntries, task);
const description = truncateExcerpt(entry.body ?? '', 160);
---
<Layout title={`${taskTitle}: assignment`} description={description}>
  <Breadcrumb
    items={[
      { label: 'Tasks', href: withBase('/', import.meta.env.BASE_URL) },
      { label: taskTitle, href: withBase(`/tasks/${task}/`, import.meta.env.BASE_URL) },
      { label: "Mr Casino's task" },
    ]}
  />
  <article class="assignment-page">
    <header class="assignment-header">
      <h1>Mr Casino&apos;s task</h1>
    </header>
    <div class="assignment-body">
      <Content />
    </div>
  </article>

  <Lightbox />
</Layout>
