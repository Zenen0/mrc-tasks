---
import { getCollection } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { withBase } from '../../../lib/paths';
import { allTaskNumbers, getTaskTitle, subtasksForTask } from '../../../lib/tasks';

export async function getStaticPaths() {
  const subtaskEntries = await getCollection('tasks');
  const taskMetaEntries = await getCollection('taskMeta');
  return allTaskNumbers(subtaskEntries, taskMetaEntries).map((task) => ({ params: { task } }));
}

const { task } = Astro.params as { task: string };
const subtaskEntries = await getCollection('tasks');
const taskMetaEntries = await getCollection('taskMeta');
const taskTitle = getTaskTitle(taskMetaEntries, task);
const hasAssignment = taskMetaEntries.some((entry) => entry.id === task);
const subtaskCount = subtasksForTask(subtaskEntries, task).length;
---
<Layout title={taskTitle} description={`Mr Casino's assignment and my own work for ${taskTitle}.`}>
  <Breadcrumb
    items={[
      { label: 'Tasks', href: withBase('/', import.meta.env.BASE_URL) },
      { label: taskTitle },
    ]}
  />
  <h1>{taskTitle}</h1>
  <div class="branch-grid">
    {hasAssignment ? (
      <a class="branch-card" href={withBase(`/tasks/${task}/assignment/`, import.meta.env.BASE_URL)}>
        <span class="card-badge">MR CASINO&apos;S TASK</span>
        <h2>The assignment</h2>
        <p>His original brief, worked example, and reference images.</p>
      </a>
    ) : (
      <div class="branch-card branch-card-pending">
        <span class="card-badge">MR CASINO&apos;S TASK</span>
        <h2>The assignment</h2>
        <p class="empty-state">Not written up yet.</p>
      </div>
    )}
    <a class="branch-card" href={withBase(`/tasks/${task}/mine/`, import.meta.env.BASE_URL)}>
      <span class="card-badge">MY TASK</span>
      <h2>My work</h2>
      <p>{subtaskCount > 0 ? `${subtaskCount} subtask${subtaskCount === 1 ? '' : 's'} so far.` : 'Nothing added yet.'}</p>
    </a>
  </div>
</Layout>
