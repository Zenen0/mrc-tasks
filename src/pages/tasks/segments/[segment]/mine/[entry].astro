---
// One My Work entry for a Segment (src/content/segments/<N>/mine/<entry>/index.md). None exist yet.
// Mirrors the Week My Work entry page (src/pages/tasks/weeks/[week]/[wtask]/mine/[entry].astro).
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../../../components/Layout.astro';
import ThumbnailGrid from '../../../../../components/ThumbnailGrid.astro';
import Lightbox from '../../../../../components/Lightbox.astro';
import Breadcrumb from '../../../../../components/Breadcrumb.astro';
import { buildEntryPageData } from '../../../../../lib/entry-page';
import { withBase } from '../../../../../lib/paths';
import { siblingSubtasks } from '../../../../../lib/tasks';
import { segmentLabel, workForSegment } from '../../../../../lib/segments';

export async function getStaticPaths() {
  const work = await getCollection('segmentWork');
  return work.map((entry) => {
    const [segment, , id] = entry.id.split('/');
    return { params: { segment, entry: id }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { segment, entry: entryId } = Astro.params as { segment: string; entry: string };
const { Content } = await render(entry);

const globMap = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/segments/**/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const { mentorImages, blocks, description, hasResponse } = buildEntryPageData(
  globMap,
  `/src/content/segments/${entry.id}`,
  entry,
);

const segmentMeta = (await getCollection('segmentMeta')).find((meta) => meta.id === segment);
const label = segmentLabel(segment, segmentMeta?.data.label);
const segmentTitle = `${label}: ${segmentMeta?.data.title ?? ''}`;
const siblings = workForSegment(await getCollection('segmentWork'), segment);
const { prev, next } = siblingSubtasks(siblings, entry.id);
const base = import.meta.env.BASE_URL;
const mineHref = `/tasks/segments/${segment}/mine/`;
---
<Layout title={`${label} · ${entryId.toUpperCase()}: ${entry.data.title}`} description={description}>
  <Breadcrumb
    items={[
      { label: 'Tasks', href: withBase('/', base) },
      { label: 'Segments', href: withBase('/tasks/segments/', base) },
      { label: segmentTitle, href: withBase(`/tasks/segments/${segment}/`, base) },
      { label: 'My Work', href: withBase(mineHref, base) },
      { label: entryId.toUpperCase() },
    ]}
  />
  {(prev || next) && (
    <nav class="subtask-pager" aria-label="Entry navigation">
      {prev && (
        <a class="pager-prev" href={withBase(`${mineHref}${prev.id.split('/').pop()}/`, base)}>
          &lsaquo; {prev.id.split('/').pop()!.toUpperCase()}: {prev.data.title}
        </a>
      )}
      {next && (
        <a class="pager-next" href={withBase(`${mineHref}${next.id.split('/').pop()}/`, base)}>
          {next.id.split('/').pop()!.toUpperCase()}: {next.data.title} &rsaquo;
        </a>
      )}
    </nav>
  )}
  <article class="subtask">
    <header class="subtask-header week-header">
      <span class="subtask-badge mono">{segmentMeta?.data.label ? label.toUpperCase() : `S${segment}`} · {entryId.toUpperCase()}</span>
      <h1>{entry.data.title}</h1>
    </header>

    {(entry.data.mentorPrompt || mentorImages.length > 0) && (
      <section class="assignment">
        <h2>Assignment</h2>
        {entry.data.mentorPrompt && <p>{entry.data.mentorPrompt}</p>}
        {mentorImages.length > 0 && (
          <div class="mentor-images">
            {mentorImages.map((img) => (
              <Image src={img.src} width={480} alt={img.parsed.label} />
            ))}
          </div>
        )}
      </section>
    )}

    <section class="captures">
      <h2>Captures</h2>
      {blocks.length > 0 ? <ThumbnailGrid blocks={blocks} /> : <p class="empty-state">No captures yet.</p>}
    </section>

    <section class="response">
      <h2>My read</h2>
      {hasResponse ? <Content /> : <p class="empty-state">Pending.</p>}
    </section>
  </article>

  <Lightbox />
</Layout>
