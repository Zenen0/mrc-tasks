---
import { getCollection, render } from 'astro:content';
import Layout from '../../../../components/Layout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import Lightbox from '../../../../components/Lightbox.astro';
import { withBase } from '../../../../lib/paths';
import { truncateExcerpt } from '../../../../lib/og';
import { adjacentSegments, segmentLabel, segmentNumbers } from '../../../../lib/segments';

export async function getStaticPaths() {
  const assignments = await getCollection('segmentAssignments');
  return assignments.map((entry) => ({ params: { segment: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { segment } = Astro.params as { segment: string };
const { Content } = await render(entry);

const segmentMetaEntries = await getCollection('segmentMeta');
const metaFor = (n: string) => segmentMetaEntries.find((meta) => meta.id === n);
const labelFor = (n: string) => segmentLabel(n, metaFor(n)?.data.label);
const label = labelFor(segment);
const segmentTitle = `${label}: ${metaFor(segment)?.data.title ?? ''}`;
const { prev, next } = adjacentSegments(segmentNumbers(segmentMetaEntries), segment);
const base = import.meta.env.BASE_URL;
const description = truncateExcerpt(entry.body ?? '', 160);
---
<Layout title={`${label} · Assignment: ${entry.data.title}`} description={description}>
  <Breadcrumb
    items={[
      { label: 'Tasks', href: withBase('/', base) },
      { label: 'Segments', href: withBase('/tasks/segments/', base) },
      { label: segmentTitle, href: withBase(`/tasks/segments/${segment}/`, base) },
      { label: 'Assignment' },
    ]}
  />
  <nav class="subtask-pager" aria-label="Segment navigation">
    {prev && (
      <a class="pager-prev" href={withBase(`/tasks/segments/${prev}/assignment/`, base)}>
        &lsaquo; {labelFor(prev)}: {metaFor(prev)?.data.title}
      </a>
    )}
    {next && (
      <a class="pager-next" href={withBase(`/tasks/segments/${next}/assignment/`, base)}>
        {labelFor(next)}: {metaFor(next)?.data.title} &rsaquo;
      </a>
    )}
  </nav>
  <article class="assignment-page chart-page">
    <header class="subtask-header week-header">
      <span class="subtask-badge mono">{label.toUpperCase()} · ASSIGNMENT</span>
      <h1>{entry.data.title}</h1>
    </header>
    <div class="assignment-body">
      <Content />
    </div>
    <nav class="week-branch-links" aria-label="This segment">
      <a href={withBase(`/tasks/segments/${segment}/mine/`, base)}>My work for this segment &rsaquo;</a>
      <a href={withBase(`/tasks/segments/${segment}/`, base)}>All of {segmentTitle}</a>
    </nav>
  </article>

  <Lightbox />
</Layout>
