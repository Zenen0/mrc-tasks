---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  href: string;
  badge: string;
  title: string;
  cover: ImageMetadata | null;
  /** Corner count; omitted (no badge) where a count has no meaning, e.g. Segment cards. */
  subtaskCount?: number;
}

const { href, badge, title, cover, subtaskCount } = Astro.props;
---
<a class="card task-card" href={href}>
  <div class="card-thumb">
    {cover ? (
      <Image src={cover} width={320} alt="" />
    ) : (
      <div class="card-thumb-title">{title}</div>
    )}
    {subtaskCount !== undefined && <span class="card-count mono">{subtaskCount}</span>}
  </div>
  <div class="card-body task-card-body">
    <span class="card-badge task-card-badge">{badge}</span>
  </div>
</a>
