---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  href: string;
  badge: string;
  title: string;
  cover: ImageMetadata | null;
  /** Count chip; omitted (no chip) where a count has no meaning, e.g. Segment cards. */
  subtaskCount?: number;
  /** What the count means (tooltip / screen-reader text), e.g. "3 formal Tasks in this Week". */
  countLabel?: string;
}

const { href, badge, title, cover, subtaskCount, countLabel } = Astro.props;
---
<a class="card task-card" href={href}>
  {cover && (
    <div class="card-thumb">
      <Image src={cover} width={320} alt="" />
    </div>
  )}
  <div class="card-body task-card-body">
    <div class="card-top">
      <span class="card-badge task-card-badge">{badge}</span>
      {subtaskCount !== undefined && (
        <span class="card-count mono" title={countLabel} aria-label={countLabel}>{subtaskCount}</span>
      )}
    </div>
    <h3 class="card-title">{title}</h3>
    <span class="card-cta" aria-hidden="true">Open</span>
  </div>
</a>
